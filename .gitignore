*.idb

# Visual Studio
.vs/
Debug/
Release/
x64/
x86/

# VS Code
# Se versiona tasks.json para que cualquiera pueda compilar y
# ejecutar el proyecto desde la interfaz, sin usar la terminal.
.vscode/*
!.vscode/tasks.json

# CMake
# (El Makefile del proyecto SI se versiona: es el build system
#  oficial y forma parte de las instrucciones de ejecucion.)
build/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake

# Archivos temporales
*.tmp
*.temp
*.log
*~

# Windows
Thumbs.db
Desktop.ini

# macOS
.DS_Store

.exe
.obj
# Corridas exportadas para el visor (se regeneran solas)
*.eco

# Python
__pycache__/
*.pyc
